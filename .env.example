# Server Configuration
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL local dev / Neon / Supabase)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vedasphere

# Cache Configuration (in-memory by default, redis optional)
CACHE_DRIVER=in-memory
REDIS_URL=redis://localhost:6379
# Weather fresh cache TTL in seconds (default 900 = 15 min)
WEATHER_TTL_SECONDS=900
# AQI cache TTL in seconds (default 1800 = 30 min)
AQI_TTL_SECONDS=1800

# AI Configuration (Anthropic SDK called only from API)
AI_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Email / Magic Link Authentication
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="VedaSphere <no-reply@vedasphere.in>"
JWT_SECRET=super-secret-jwt-key-min-32-chars-long

# Web Client Environment
NEXT_PUBLIC_API_URL=http://localhost:4000
